# ============================================================
#  Attendify — .gitignore
# ============================================================

# ─── Python ──────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyo
*.pyd

# ─── Virtual Environments ────────────────────────────────────
venv/
venv_attendance/
.venv/
env/
ENV/

# ─── IDE / Editor ────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.project
.settings/

# ─── PyInstaller Build Artifacts ─────────────────────────────
build/
dist/
*.spec
*.exe
Attendify_Portable/

# ─── Database ────────────────────────────────────────────────
instance/
*.db
*.sqlite
*.sqlite3

# ─── User Uploads (contains personal data) ───────────────────
user_uploads/
app/static/uploads/*
!app/static/uploads/.gitkeep

# ─── Testing / Cache ────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# ─── Environment Variables / Secrets ─────────────────────────
.env
.flaskenv
*.pem
*.key

# ─── OS Files ────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─── Logs ────────────────────────────────────────────────────
*.log
logs/

# ─── Misc ────────────────────────────────────────────────────
*.bak
*.tmp
*.temp
